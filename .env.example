# ─── Character Pixels — Variabili d'ambiente ─────────────────────────────────
#
# Questo file è un TEMPLATE. Non inserire mai valori reali qui.
# Copia come .env e compila con i tuoi dati:
#   cp .env.example .env
#
# .env è già nel .gitignore — non verrà mai committato.
# I secrets del Worker vanno impostati con `wrangler secret put`, non qui.

# ─── Meta / Instagram ─────────────────────────────────────────────────────────
# Long-Lived User Access Token (valido 60 giorni, rinnovabile)
# Ottienilo da: developers.facebook.com/tools/explorer
META_ACCESS_TOKEN=

# Instagram Business Account ID
# Ottienilo con: GET /me/accounts → GET /{page_id}?fields=instagram_business_account
INSTAGRAM_USER_ID=

# Meta App ID e App Secret (necessari per rinnovare il token)
META_APP_ID=
META_APP_SECRET=

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# URL pubblico del bucket (Dashboard R2 → bucket → Settings → Public access)
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev

# Nome del bucket R2
R2_BUCKET_NAME=character-pixels
